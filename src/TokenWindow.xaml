<Window x:Class="ClickUpWidget.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підключити ClickUp" Width="452" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        TextElement.FontFamily="{DynamicResource Ui}" TextElement.Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0E0E11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#7AA7FF" CornerRadius="9" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,20">
        <Border CornerRadius="16" Background="{DynamicResource CardSolid}">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.45"/></Border.Effect>
        </Border>
        <Border CornerRadius="16" Background="{DynamicResource CardSolid}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" Padding="22,20,22,20">
            <StackPanel>
                <Grid Background="Transparent" MouseLeftButtonDown="Drag">
                    <TextBlock Text="Підключи ClickUp" FontSize="17" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource Link}" HorizontalAlignment="Right" Click="Close_Click"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Content="&#xE8BB;"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Fg2}" Margin="0,10,0,0" LineHeight="19">
                    Віджету потрібен твій особистий API-токен. Він лишається тільки на цьому комп'ютері, зашифрований під твій обліковий запис Windows.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Fg2}" Margin="0,10,0,0" LineHeight="19">
                    ClickUp → аватар унизу зліва → Settings → Apps → API Token → Generate / Copy.
                </TextBlock>
                <Button Style="{StaticResource Link}" Margin="0,6,0,0" Click="OpenTokenPage" Content="Відкрити цю сторінку в ClickUp ↗"/>

                <Border Margin="0,16,0,0" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                        Background="{DynamicResource Hover}" Padding="10,7">
                    <TextBox x:Name="TokenBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                             CaretBrush="{DynamicResource Fg}" FontFamily="Consolas" FontSize="13"/>
                </Border>
                <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" Foreground="#FF8A80" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Grid Margin="0,18,0,0">
                    <TextBlock x:Name="BusyText" Text="Перевіряю…" FontSize="12" Foreground="{DynamicResource Fg3}"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Save_Click"
                            IsDefault="True" Content="Підключити"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
