<UserControl x:Class="ClickUpWidget.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClickUpWidget"
             TextElement.Foreground="{DynamicResource Fg}"
             TextElement.FontFamily="{DynamicResource Ui}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Маленька квадратна кнопка з іконкою -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource Btn}"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Прозора кнопка-іконка в шапці -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Текстова кнопка в нижньому рядку -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Рядок у меню статусів -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="9,7">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкий скролбар -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Btn}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
        </Style>

        <!-- Рядок задачі -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:TaskRow}">
            <!-- Висота рядка і ширина правої колонки фіксовані: при наведенні нічого не стрибає -->
            <Border x:Name="Row" Padding="8,4" CornerRadius="10" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900"
                    MouseLeftButtonUp="Row_Click">
                <Grid Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="9" Height="9" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,10,0"
                             Stroke="{Binding StatusBrush}" Fill="{Binding StatusBrush}"/>
                    <Border Grid.Column="1" Background="{Binding ChipBack}" CornerRadius="6" Padding="6,1,6,2" Margin="0,0,10,0"
                            VerticalAlignment="Center" MinWidth="30"
                            Visibility="{Binding HasProject, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Project}" Foreground="{Binding ChipFore}" FontSize="10.5" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <!-- Дедлайн і кнопки в одній клітинці: колонка завжди займає ширину більшого з них -->
                    <TextBlock x:Name="Due" Grid.Column="3" Text="{Binding DueText}" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <StackPanel x:Name="Acts" Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Hidden"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="StatusBtn_Click"
                                ToolTip="Змінити статус" Content="&#xE70D;"/>
                        <Button x:Name="TimerBtn" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Запустити таймер"
                                Command="{Binding DataContext.ToggleTimer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Content="&#xE768;"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Hollow}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Due" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="TimerBtn" Property="Content" Value="&#xE71A;"/>
                    <Setter TargetName="TimerBtn" Property="ToolTip" Value="Зупинити таймер"/>
                    <Setter TargetName="TimerBtn" Property="Foreground" Value="{DynamicResource TimerFg}"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Due" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Шапка: за неї панель можна перетягувати -->
        <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,12" MouseLeftButtonDown="Header_Down">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="Мої задачі" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TodayText}" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Command="{Binding Refresh}" ToolTip="Оновити" Content="&#xE72C;"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ShowMenu}" ToolTip="Налаштування" Content="&#xE712;"/>
            </StackPanel>
        </Grid>

        <!-- Немає токена -->
        <Border Visibility="{Binding NeedsToken, Converter={StaticResource Vis}}" Background="{DynamicResource Hover}"
                CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Щоб бачити задачі, підключи ClickUp через особистий API-токен." TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{DynamicResource Fg2}"/>
                <Button Style="{StaticResource LinkButton}" Command="{Binding AddToken}" Margin="0,8,0,0" FontSize="12.5"
                        Foreground="{DynamicResource Fg}" Content="Підключити →"/>
            </StackPanel>
        </Border>

        <!-- Запущений таймер -->
        <Border Visibility="{Binding HasTimer, Converter={StaticResource Vis}}" Background="{DynamicResource TimerBg}"
                BorderBrush="{DynamicResource TimerLine}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource TimerFg}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Grid.Column="1" Background="{Binding TimerChipBack}" CornerRadius="6" Padding="6,1,6,2" Margin="0,0,10,0"
                        VerticalAlignment="Center" Visibility="{Binding HasTimerProject, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding TimerProject}" Foreground="{Binding TimerChipFore}" FontSize="10.5" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding TimerTitle}" FontSize="13" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding TimerClock}" FontSize="13" FontWeight="SemiBold" Margin="10,0,10,0"
                           Foreground="{DynamicResource TimerFg}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Background="{DynamicResource TimerLine}"
                        Foreground="{DynamicResource TimerFg}" Command="{Binding StopTimer}" ToolTip="Зупинити таймер"
                        Content="&#xE71A;"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="600" Focusable="False">
            <StackPanel Margin="0,0,2,0">
                <!-- Сьогодні: дедлайн сьогодні або вже минув. Без кольорових акцентів. -->
                <StackPanel Visibility="{Binding HasDue, Converter={StaticResource Vis}}">
                    <Grid Margin="4,4,4,4">
                        <TextBlock Text="СЬОГОДНІ" Style="{StaticResource Section}"/>
                        <TextBlock Text="{Binding DueCount}" Style="{StaticResource Section}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DueRows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                </StackPanel>

                <TextBlock x:Name="CompactEmpty" Text="На сьогодні дедлайнів немає" FontSize="12.5" Margin="4,2,4,6"
                           Foreground="{DynamicResource Fg2}" Visibility="Collapsed"/>

                <StackPanel x:Name="AllSection">
                    <Grid Margin="4,12,4,2" Visibility="{Binding HasTasks, Converter={StaticResource Vis}}">
                        <TextBlock Text="УСІ ВІДКРИТІ" Style="{StaticResource Section}"/>
                        <TextBlock Text="{Binding OpenCount}" Style="{StaticResource Section}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StatusGroup}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,10,8,2">
                                        <Ellipse x:Name="GDot" Width="8" Height="8" StrokeThickness="2" Stroke="{Binding Brush}"
                                                 Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Fg2}"/>
                                        <TextBlock Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource Fg3}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Hollow}" Value="True">
                                        <Setter TargetName="GDot" Property="Fill" Value="Transparent"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="Відкритих задач немає" FontSize="12.5" Margin="4,8,4,4"
                               Foreground="{DynamicResource Fg2}" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижній рядок -->
        <Border x:Name="Footer" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="2,9,2,0">
            <Grid>
                <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{DynamicResource Fg3}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding OpenClickUp}"
                        Content="Відкрити ClickUp ↗" x:Name="OpenLink"/>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding ApplyUpdate}"
                        Foreground="{DynamicResource Fg}" Content="{Binding UpdateText}"
                        Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}" Background="{DynamicResource CardSolid}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
