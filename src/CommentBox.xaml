<UserControl x:Class="ClickUpWidget.CommentBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{DynamicResource Ui}" TextElement.Foreground="{DynamicResource Fg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>

    <Border Margin="0,6,0,2" CornerRadius="10" Background="{DynamicResource Hover}" BorderThickness="1"
            BorderBrush="{DynamicResource Line}" Padding="10,7,6,6">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Підказка, поки поле порожнє -->
                <TextBlock x:Name="Hint" Text="Коментар… @ — згадати когось" FontSize="12.5" Foreground="{DynamicResource Fg3}"
                           IsHitTestVisible="False" Margin="2,1,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="Box" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12.5"
                         Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}" SelectionBrush="#7AA7FF"
                         TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="Box_PreviewKeyDown" TextChanged="Box_TextChanged"
                         SelectionChanged="Box_SelectionChanged" LostKeyboardFocus="Box_LostKeyboardFocus"/>
                <Button x:Name="SendBtn" Grid.Column="1" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                        VerticalAlignment="Bottom" ToolTip="Надіслати (Enter)" Content="&#xE724;" Click="Send_Click"/>
            </Grid>
            <Grid Margin="2,5,0,0">
                <TextBlock x:Name="Note" FontSize="10.5" Foreground="{DynamicResource Fg3}"
                           Text="Enter — надіслати · Shift+Enter — новий рядок · Esc — скасувати"/>
                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FF8A80" TextWrapping="Wrap" Background="{DynamicResource CardSolid}"
                           Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
