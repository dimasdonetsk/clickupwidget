<Window x:Class="ClickUpWidget.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClickUpWidget"
        Title="ClickUp Widget" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True">
    <Grid Margin="16,12,16,20">
        <!-- Тінь окремим шаром, щоб текст не розмивався -->
        <Border CornerRadius="18" Background="{DynamicResource CardSolid}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" Padding="14,16,14,12">
            <local:TasksView x:Name="View"/>
        </Border>
    </Grid>
</Window>
