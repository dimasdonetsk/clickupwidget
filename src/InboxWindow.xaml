<Window x:Class="ClickUpWidget.InboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClickUpWidget"
        Title="ClickUp Widget — оновлення" Width="352" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        TextElement.FontFamily="{DynamicResource Ui}" TextElement.Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="InboxRowTemplate" DataType="{x:Type local:InboxRow}">
            <Border x:Name="Row" Padding="8,7" CornerRadius="10" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="Row_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Тиха крапка «нове» -->
                    <Ellipse x:Name="NewDot" Width="6" Height="6" Fill="#7AA7FF" VerticalAlignment="Top"
                             HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Hidden"/>
                    <StackPanel Grid.Column="1">
                        <!-- Заголовок і час; при наведенні час змінюють кнопки (ширина та сама, нічого не стрибає) -->
                        <Grid Height="20">
                            <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,64,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Time" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Fg3}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <StackPanel x:Name="Acts" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Hidden">
                                <Button x:Name="ReplyBtn" Style="{StaticResource IconButton}" Width="22" Height="20" Tag="{Binding}"
                                        Click="Reply_Click" ToolTip="Відповісти" Content="&#xE97A;"/>
                                <Button Style="{StaticResource IconButton}" Width="22" Height="20" Margin="5,0,0,0" Tag="{Binding}"
                                        Click="Comment_Click" ToolTip="Залишити коментар у задачі" Content="&#xE8BD;"/>
                            </StackPanel>
                        </Grid>

                        <!-- Текст: коментар до двох рядків, або опис зміни -->
                        <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                   Visibility="{Binding HasText, Converter={StaticResource Vis}}"/>

                        <!-- Було → стало -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding ShowChange, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasFrom, Converter={StaticResource Vis}}">
                                <Ellipse Width="8" Height="8" StrokeThickness="2" Stroke="{Binding FromBrush}" Fill="{Binding FromBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                         Visibility="{Binding ShowDots, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="{Binding FromLabel}" FontSize="12.5" Foreground="{DynamicResource Fg2}"/>
                                <TextBlock Text="→" FontSize="12.5" Foreground="{DynamicResource Fg3}" Margin="7,0,7,0"/>
                            </StackPanel>
                            <Ellipse Width="8" Height="8" StrokeThickness="2" Stroke="{Binding ToBrush}" Fill="{Binding ToBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                     Visibility="{Binding ShowDots, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding ToLabel}" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Яка задача -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding ChipBack}" CornerRadius="5" Padding="5,0,5,1" Margin="0,0,7,0"
                                    VerticalAlignment="Center" Visibility="{Binding HasProject, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Project}" Foreground="{Binding ChipFore}" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource Fg3}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <ContentPresenter Content="{Binding Composer}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                    <Setter TargetName="NewDot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanReply}" Value="False">
                    <Setter TargetName="ReplyBtn" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComposing}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                    <Setter TargetName="Row" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                    <Setter TargetName="Acts" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Time" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,12,16,20">
        <Border CornerRadius="18" Background="{DynamicResource CardSolid}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" Padding="12,14,12,10">
            <StackPanel>
                <!-- Шапка: за неї віконце перетягується -->
                <Grid Background="Transparent" Margin="4,0,0,8" MouseLeftButtonDown="Header_Down">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Оновлення" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Unread}" FontSize="12" Foreground="{DynamicResource Fg3}" Margin="8,1,0,0"
                                   Visibility="{Binding HasUnread, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MarkRead}" ToolTip="Позначити все прочитаним"
                                Content="&#xE73E;" Visibility="{Binding HasUnread, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ShowMenu}" ToolTip="Налаштування"
                                Content="&#xE712;"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Поки тихо. Тут з'являться нові коментарі й зміни статусів у твоїх задачах." TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{DynamicResource Fg2}" Margin="4,0,4,6" LineHeight="18"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>

                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="360" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InboxRowTemplate}"
                                  Focusable="False" Margin="0,0,2,0"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
